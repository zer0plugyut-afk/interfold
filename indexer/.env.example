# InterFold indexer — NEW Supabase project only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mainnet Alchemy (or similar). Public RPCs often 403 on eth_getLogs.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

ETHERSCAN_API_KEY=

# Tip-only sync cadence (default 5 minutes)
POLL_INTERVAL_MS=300000
# Free RPC: keep eth_getLogs windows small (default 2000). VE contracts use 1500.
LOG_CHUNK_SIZE=2000
# Pause between getLogs chunks (ms) to avoid free-tier rate limits
LOG_CHUNK_PAUSE_MS=120

# Optional: only tip-sync these keys (comma). Example governance catch-up:
# CONTRACT_KEYS=escrow,escrowIvotes,exitQueue
# Or: npm run backfill:governance  (= --once --governance-only)

# ---------------------------------------------------------------------------
# CRISP (encrypted ballot) — src/crisp.js
# Addresses default from indexer/crisp-mainnet.json (interfold PR 1870).
# Cutover: run supabase/migrations/005_wipe_crisp_sepolia_for_mainnet.sql
# then npm start.
# ---------------------------------------------------------------------------
CRISP_ENABLED=true
CRISP_NETWORK=mainnet
CRISP_CHAIN_ID=1
# Leave unset to reuse RPC_URL (mainnet).
CRISP_RPC_URL=
CRISP_PROGRAM_ADDRESS=0x847A22303639017bcDB7F7E49EEa4a4629c1169f
CRISP_PROGRAM_DEPLOY_BLOCK=25812209
CRISP_SELF_REGISTRY_ADDRESS=0x988104E6275359126bbDDDeE35159bd7d138A61C
CRISP_SELF_REGISTRY_DEPLOY_BLOCK=25812212
CRISP_INTERFOLD_ADDRESS=0x28cF63B459e6218C69EA97ea7D90541cf648c715
CRISP_INTERFOLD_DEPLOY_BLOCK=25812209
CRISP_EVENTS_TABLE=if_crisp_mainnet_events
CRISP_SYNC_TABLE=if_crisp_mainnet_sync_state

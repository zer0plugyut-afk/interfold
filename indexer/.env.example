# InterFold indexer — NEW Supabase project only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mainnet Alchemy (or similar). Public RPCs often 403 on eth_getLogs.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

ETHERSCAN_API_KEY=

# Tip-only sync cadence (default 5 minutes)
POLL_INTERVAL_MS=300000
LOG_CHUNK_SIZE=10000

# ---------------------------------------------------------------------------
# CRISP (encrypted ballot) — separate module: src/crisp.js
# Today = Sepolia. When mainnet CRISP ships:
#   1) npm run wipe-crisp-sepolia   (or run 005_wipe_crisp_sepolia_for_mainnet.sql)
#   2) Point these at mainnet addresses + mainnet RPC
#   3) npm start
# ---------------------------------------------------------------------------
CRISP_ENABLED=true
CRISP_NETWORK=sepolia
CRISP_CHAIN_ID=11155111
CRISP_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CRISP_PROGRAM_ADDRESS=0x8D9c914446451fdE7FC0fdBcF20573E878c3DE5a
CRISP_PROGRAM_DEPLOY_BLOCK=11508527
CRISP_INTERFOLD_ADDRESS=0x38A8A686A420023568E995b57B4FBEA371555Ba7
CRISP_INTERFOLD_DEPLOY_BLOCK=11508431
CRISP_EVENTS_TABLE=if_crisp_sepolia_events
CRISP_SYNC_TABLE=if_crisp_sepolia_sync_state
